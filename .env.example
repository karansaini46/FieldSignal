# ==============================================================================
# FieldSignal — Environment Variables Configuration
# ==============================================================================

# Application
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldsignal?schema=public"
# DIRECT_URL is required when using connection poolers (Neon, Supabase, PgBouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fieldsignal?schema=public"

# Authentication & Session Security
# Generate secure random secret with: openssl rand -base64 32
JWT_SECRET="fieldsignal-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Gnani AI Speech Recognition Service (Vachana REST API v3)
# Base endpoint: https://api.vachana.ai/stt/v3
# Auth: Sent via 'X-API-Key-ID' header
GNANI_AI_API_KEY="gnani_dev_api_key_placeholder"
GNANI_AI_ACCESS_KEY="gnani_dev_access_key_placeholder"
GNANI_AI_ENDPOINT="https://api.vachana.ai/stt/v3"
# ASR Model version: "prisma-v3.0" (default multilingual with code-switching) or "prisma-v2.5"
GNANI_AI_MODEL="prisma-v3.0"
# Primary and fallback languages: e.g. "hi-IN,en-IN" (Hinglish/code-switch) or "indic-auto"
GNANI_AI_LANGUAGE_CODE="hi-IN,en-IN"
# Request timeout in milliseconds (default: 8000ms)
GNANI_AI_TIMEOUT_MS=8000
# Safe max retries on 5xx / 429 errors (default: 2)
GNANI_AI_MAX_RETRIES=2
# Enable simulated mock transcription fallback in local dev when key is placeholder
GNANI_AI_MOCK_FALLBACK=true

# AI Extraction Layer (Gemini or OpenAI)
AI_PROVIDER="gemini" # "gemini" | "openai"
AI_API_KEY="ai_service_api_key_placeholder"
AI_MODEL_NAME="gemini-1.5-flash"

# Local Media Storage
AUDIO_STORAGE_DIR="./uploads/audio"
MAX_AUDIO_FILE_SIZE_MB=10
