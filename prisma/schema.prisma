// FieldSignal — Database Schema
// Solar Plant O&M Voice-First Maintenance Intelligence Platform

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SUPERVISOR
  TECHNICIAN
}

enum SiteStatus {
  OPERATIONAL
  COMMISSIONING
  MAINTENANCE
  DECOMMISSIONED
}

enum AssetType {
  CENTRAL_INVERTER
  STRING_INVERTER
  TRANSFORMER
  STRING_COMBINER_BOX
  TRACKER_CONTROLLER
  TRACKER_MOTOR
  MODULE_STRING
  HT_PANEL_BREAKER
  WEATHER_STATION
  DC_DISCONNECT
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  DEGRADED
  FAULTED
  MAINTENANCE
  DECOMMISSIONED
}

enum IncidentStatus {
  DRAFT
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultCategory {
  OVER_TEMPERATURE
  INSULATION_FAILURE
  EARTH_FAULT
  GRID_TRIP
  COMMUNICATION_LOSS
  TRACKER_FAILURE
  DC_ARC_FIRE
  STRING_UNDERPERFORMANCE
  FUSE_BLOWN
  MECHANICAL_DAMAGE
  OTHER
}

enum IncidentEventType {
  STATUS_CHANGE
  ASSIGNMENT
  FIELD_UPDATE
  CONFIRMATION
  APPROVAL
  REOPENED
  NOTE_ADDED
}

enum ClarificationStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

/// Top-level enterprise tenant representing a solar operations company
model Organization {
  id        String   @id @default(uuid())
  name      String   // e.g. "Sunrise Solar Operations"
  code      String   @unique // e.g. "SUNRISE-SOLAR"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites     Site[]
  users     User[]

  @@map("organizations")
}

/// User accounts (Technicians, Site Supervisors, Plant Managers)
model User {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String?   // Optional primary site location
  name           String
  phone          String    @unique
  email          String?   @unique
  passwordHash   String
  role           UserRole  @default(TECHNICIAN)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  reportedIncidents      Incident[]       @relation("IncidentReporter")
  assignedIncidents      Incident[]       @relation("IncidentAssignee")
  incidentEvents         IncidentEvent[]
  audioRecordings        AudioRecording[]
  requestedClarifications Clarification[]  @relation("ClarificationRequester")
  respondedClarifications Clarification[]  @relation("ClarificationResponder")

  @@index([organizationId])
  @@index([siteId, role])
  @@map("users")
}

/// Solar PV plant installation site belonging to an Organization
model Site {
  id             String     @id @default(uuid())
  organizationId String
  name           String     // e.g. "Bhadla Solar Park - Sector IV"
  code           String     @unique // e.g. "SUN-BHA-04"
  capacityMw     Decimal    @db.Decimal(8, 2)
  location       String?    // e.g. "Phalodi District, Rajasthan"
  latitude       Float?
  longitude      Float?
  timezone       String     @default("Asia/Kolkata")
  status         SiteStatus @default(OPERATIONAL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  assets         Asset[]
  incidents      Incident[]
  audioRecordings AudioRecording[]

  @@index([organizationId])
  @@map("sites")
}

/// Physical solar plant equipment organized in a hierarchical tree
model Asset {
  id              String      @id @default(uuid())
  siteId          String
  parentAssetId   String?     // Hierarchical link (e.g. Inverter Station -> Central Inverter -> SMB)
  assetTag        String      // e.g. "INV-01", "SCB-04-A", "TR-01"
  name            String      // e.g. "Central Inverter 1 (SMA 2.5MW)"
  assetType       AssetType
  block           String      // e.g. "Block-A", "Inverter Station 01"
  row             String?     // e.g. "Row 12"
  status          AssetStatus @default(OPERATIONAL)
  manufacturer    String?     // e.g. "SMA", "ABB", "Schneider"
  model           String?
  serialNumber    String?
  ratedCapacityKw Float?
  commissionDate  DateTime?
  metadata        Json?       // Technical specifications, voltage ratings, string mappings
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parentAsset Asset?     @relation("AssetHierarchy", fields: [parentAssetId], references: [id], onDelete: SetNull)
  children    Asset[]    @relation("AssetHierarchy")
  incidents   Incident[]

  @@unique([siteId, assetTag, block])
  @@index([siteId, assetType])
  @@index([assetTag])
  @@map("assets")
}

/// Maintenance fault tickets created via voice or manual confirmation
model Incident {
  id                 String           @id @default(uuid())
  ticketNumber       String           @unique // e.g. "INC-2026-0001"
  siteId             String
  assetId            String?          // Optional: populated once equipment is identified
  reportedByUserId   String
  assignedToUserId   String?
  audioRecordingId   String?          @unique // Optional: audio recordings are not required for every incident

  status             IncidentStatus   @default(OPEN)
  priority           IncidentPriority @default(MEDIUM)
  faultCategory      FaultCategory    @default(OTHER)
  title              String
  description        String           @db.Text
  symptoms           String?          @db.Text
  errorCode          String?          // e.g. "E-14", "F-042"
  
  // Immutability requirement: original voice transcript snapshot is permanently preserved
  originalTranscript String?          @db.Text
  detectedLanguage   String?          // "hi-IN", "en-IN", "hinglish"
  
  // Validation & Intelligence metadata
  missingFields      Json?            // e.g. ["assetTag", "errorCode"]
  isRepeatFault      Boolean          @default(false)
  repeatCount30d     Int              @default(0)

  confirmedAt        DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  resolutionNotes    String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  site               Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  asset              Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reportedBy         User             @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  assignedTo         User?            @relation("IncidentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  audioRecording     AudioRecording?  @relation(fields: [audioRecordingId], references: [id], onDelete: SetNull)

  events             IncidentEvent[]
  clarifications     Clarification[]

  @@index([siteId, status])
  @@index([assetId, createdAt])
  @@index([priority, status])
  @@index([reportedByUserId])
  @@map("incidents")
}

/// Immutable audit trail recording state transitions, approvals, and field revisions
model IncidentEvent {
  id          String            @id @default(uuid())
  incidentId  String
  userId      String
  eventType   IncidentEventType
  fromStatus  IncidentStatus?
  toStatus    IncidentStatus?
  title       String
  description String?           @db.Text
  diff        Json?             // Before/After patch of modified fields
  createdAt   DateTime          @default(now())

  incident    Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([userId])
  @@map("incident_events")
}

/// Optional voice recording metadata & immutable raw transcript from Gnani AI
model AudioRecording {
  id                  String    @id @default(uuid())
  userId              String
  siteId              String
  filePath            String    // Local file path or storage reference
  mimeType            String    @default("audio/webm")
  fileSizeBytes       Int
  durationSeconds     Float
  
  // Immutability requirement: original transcript captured from ASR engine cannot be overwritten
  originalTranscript  String    @db.Text
  language            String?   // "hi-IN", "en-IN", "hinglish"
  confidence          Float?    // ASR confidence score (0.0 to 1.0)
  processingLatencyMs Int?      // Time taken for speech recognition
  metadata            Json?     // Codecs, bitrates, audio quality metrics
  createdAt           DateTime  @default(now())

  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  incident            Incident?

  @@index([userId, createdAt])
  @@index([siteId])
  @@map("audio_recordings")
}

/// Interactive clarifications associated with incidents for missing fields or ambiguity resolution
model Clarification {
  id                String              @id @default(uuid())
  incidentId        String
  requestedByUserId String?             // Null if initiated automatically by AI validation engine
  respondedByUserId String?             // Technician who resolved the clarification
  question          String              @db.Text
  missingField      String?             // e.g. "block", "errorCode", "symptom"
  response          String?             @db.Text
  status            ClarificationStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  respondedAt       DateTime?

  incident          Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  requestedBy       User?               @relation("ClarificationRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  respondedBy       User?               @relation("ClarificationResponder", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, status])
  @@map("clarifications")
}
